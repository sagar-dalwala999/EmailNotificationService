# ==============================================================================
# INBOXPULSE EMAIL NOTIFICATION SERVICE (HEADLESS DAEMON) CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GMAIL OAUTH CREDENTIALS (REQUIRED)
# ------------------------------------------------------------------------------
# Create in Google Cloud Console -> APIs & Services -> Credentials (OAuth 2.0 Client ID)
# Make sure Authorised redirect URI includes: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
# Run `npm run setup` or `npm run auth:google` to generate your refresh token:
GOOGLE_REFRESH_TOKEN=

# ------------------------------------------------------------------------------
# 2. GEMINI AI TRIAGING (OPTIONAL - Google AI Studio)
# ------------------------------------------------------------------------------
# Optional: Get key from https://aistudio.google.com/
# Leave BLANK to run in 100% Zero-AI mode (uses local VIP, keyword rules, and heuristics).
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. WHATSAPP DISPATCH CONFIGURATION
# ------------------------------------------------------------------------------
# Enable or disable WhatsApp notifications ('true' or 'false')
WHATSAPP_ENABLED=true
# Recipient phone with country code (e.g. 919876543210). Leave BLANK to message yourself.
WHATSAPP_TARGET_NUMBER=

# ------------------------------------------------------------------------------
# 4. SLACK DISPATCH CONFIGURATION
# ------------------------------------------------------------------------------
# Enable or disable Slack notifications ('true' or 'false')
SLACK_ENABLED=true
# Incoming Webhook URL from https://api.slack.com/apps (Recommended)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/XXXXX
# Optional Bot Token alternative (leave blank if using Webhook):
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# ------------------------------------------------------------------------------
# 5. STANDING RULES & POLLING INTERVAL (DEFAULT MODE)
# ------------------------------------------------------------------------------
# Minimum Urgency score (1 to 10) required to trigger alerts. Default: 7
URGENCY_THRESHOLD=7

# Comma-separated sender emails/names that always trigger immediate Critical alerts:
VIP_SENDERS=boss@company.com,client@partner.com,hr@company.com

# Comma-separated keyword phrases that trigger immediate Critical alerts:
KEYWORD_FILTERS=daily tracker,invoice,urgent,deadline,production issue,payment

# Polling frequency in seconds (Default check rate when running without webhooks):
POLLING_INTERVAL_SEC=60

# ------------------------------------------------------------------------------
# 6. ADVANCED (OPTIONAL): REAL-TIME PUSH WEBHOOK VIA GOOGLE CLOUD PUB/SUB
# ------------------------------------------------------------------------------
# Leave BLANK to use standard polling above (Simplest - no extra GCP setup).
# Or enter your Google Cloud Pub/Sub topic for instant 0ms real-time push webhooks:
# Format: projects/YOUR_PROJECT_ID/topics/YOUR_TOPIC_NAME
GMAIL_PUBSUB_TOPIC=

# Local / Server port for the webhook receiver & health check endpoint (Default: 5000)
PORT=5000